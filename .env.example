# Copy to .env. docker-compose reads this automatically for variable
# substitution; scripts/ and the backend load it too.

# --- Postgres (user + auth/credential metadata) ---
# Consumed by the postgres container for first-time setup.
POSTGRES_USER=intellivault
POSTGRES_PASSWORD=intellivault
POSTGRES_DB=intellivault
POSTGRES_PORT=5432

# DSN used by the backend and the yoyo migration CLI. Native dev: localhost.
# docker-compose.yml overrides host to `postgres` for the backend container.
DATABASE_URL=postgresql://intellivault:intellivault@localhost:5432/intellivault
# Separate database (same instance) for test runs — created on first init
# by docker/initdb/01-create-test-db.sh. Tests never touch DATABASE_URL's db.
TEST_DATABASE_URL=postgresql://intellivault:intellivault@localhost:5432/intellivault_test

# --- Neo4j (graph + native vector index) ---
NEO4J_PASSWORD=intellivault
NEO4J_USER=neo4j
# Bolt URI used by the backend. Native dev: localhost. docker-compose.yml
# overrides this to bolt://neo4j:7687 for the backend container.
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Disposable test instance (docker compose --profile test). Integration
# tests connect here, never to the ports above.
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_TEST_PASSWORD=testpassword
NEO4J_TEST_HTTP_PORT=7475
NEO4J_TEST_BOLT_PORT=7688

# --- Arize-Phoenix (agent observability) ---
# Base URL the backend sends OTLP traces to and probes for health.
# docker-compose.yml overrides this to http://phoenix:6006 for the backend.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# --- Ollama (host-installed, see scripts/ollama-dev) ---
# Local/native default is localhost. When the backend runs inside
# docker-compose, docker-compose.yml overrides OLLAMA_URL to
# http://host.docker.internal:11434 (the host process, reached from the
# container).
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:8b
