# Copy to .env. docker-compose reads this automatically for variable
# substitution; scripts/ and the backend load it too.

# --- Postgres (user + auth/credential metadata) ---
# Consumed by the postgres container for first-time setup.
POSTGRES_USER=intellivault
POSTGRES_PASSWORD=intellivault
POSTGRES_DB=intellivault
POSTGRES_PORT=5432

# DSN used by the backend and the yoyo migration CLI. Native dev: localhost.
# docker-compose.yml overrides host to `postgres` for the backend container.
DATABASE_URL=postgresql://intellivault:intellivault@localhost:5432/intellivault
# Separate database (same instance) for test runs — created on first init
# by docker/initdb/01-create-test-db.sh. Tests never touch DATABASE_URL's db.
TEST_DATABASE_URL=postgresql://intellivault:intellivault@localhost:5432/intellivault_test
# asyncpg connection pool bounds (min stays 0 so start-up survives a down DB).
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=20

# --- Neo4j (graph + native vector index) ---
NEO4J_PASSWORD=intellivault
NEO4J_USER=neo4j
# Bolt URI used by the backend. Native dev: localhost. docker-compose.yml
# overrides this to bolt://neo4j:7687 for the backend container.
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Disposable test instance (docker compose --profile test). Integration
# tests connect here, never to the ports above.
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_TEST_PASSWORD=testpassword
NEO4J_TEST_HTTP_PORT=7475
NEO4J_TEST_BOLT_PORT=7688

# --- Arize-Phoenix (agent observability) ---
# Base URL the backend sends OTLP traces to and probes for health.
# docker-compose.yml overrides this to http://phoenix:6006 for the backend.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# --- Ollama (host-installed, see scripts/ollama-dev) ---
# Local/native default is localhost. When the backend runs inside
# docker-compose, docker-compose.yml overrides OLLAMA_URL to
# http://host.docker.internal:11434 (the host process, reached from the
# container).
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:8b

# --- Agent loop (Redis-backed taskiq queue) ---
# The agent worker runs as its own process (see backend/app/agent/). Native dev
# points at localhost; docker-compose.yml overrides REDIS_URL to redis://redis:6379/0
# for the backend + agent-worker containers. Use "memory://" to fall back to
# taskiq's in-memory broker with no Redis at all.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# SearXNG web-search MCP server (streamable HTTP). Compose overrides this to the
# in-network mcp-searxng service.
AGENT_SEARCH_MCP_URL=http://localhost:8770/mcp

# --- Backend / frontend ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Allowed frontend origin(s) for CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000
# URL the browser uses to reach the backend; baked into the frontend build.
PUBLIC_BACKEND_URL=http://localhost:8000

# --- Auth / WebAuthn ---
# RP id is the effective domain (no scheme/port); WEBAUTHN_ORIGIN is the exact
# origin the passkey ceremony runs on (the frontend). Real deploys set these to
# the deployed domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=IntelliVault
WEBAUTHN_ORIGIN=http://localhost:3000
# Session cookie lifetime + flags. Defaults suit http localhost with a shared
# hostname. Split-domain deploys (app.example.com + api.example.com) set:
#   SESSION_COOKIE_SECURE=true
#   SESSION_COOKIE_SAMESITE=none
#   SESSION_COOKIE_DOMAIN=.example.com
SESSION_TTL_HOURS=720
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=.example.com
