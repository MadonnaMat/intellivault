{
  "components": {
    "schemas": {
      "HealthResponse": {
        "description": "Aggregate health across every downstream dependency.",
        "properties": {
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceStatus"
            },
            "title": "Services",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "services"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ServiceStatus": {
        "description": "Result of probing a single downstream dependency.",
        "properties": {
          "degraded": {
            "default": false,
            "title": "Degraded",
            "type": "boolean"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok",
          "detail",
          "latency_ms"
        ],
        "title": "ServiceStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "IntelliVault",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Deep readiness \u2014 probes Postgres, Neo4j, Phoenix and Ollama concurrently.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Liveness probe \u2014 the process is up. Used by the container healthcheck.",
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live",
        "tags": [
          "health"
        ]
      }
    }
  }
}
