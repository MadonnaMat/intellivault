{
  "components": {
    "schemas": {
      "AddPasskeyFinishRequest": {
        "properties": {
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "credential"
        ],
        "title": "AddPasskeyFinishRequest",
        "type": "object"
      },
      "CredentialSummary": {
        "description": "One registered passkey, as shown on the account page.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "transports": {
            "items": {
              "type": "string"
            },
            "title": "Transports",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "last_used_at",
          "transports"
        ],
        "title": "CredentialSummary",
        "type": "object"
      },
      "Entity": {
        "description": "An entity node as returned to the caller.",
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "title": "Attributes",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "visibility": {
            "enum": [
              "private",
              "public"
            ],
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner_id",
          "visibility",
          "name",
          "kind",
          "attributes",
          "created_at",
          "updated_at"
        ],
        "title": "Entity",
        "type": "object"
      },
      "EntityInput": {
        "description": "The caller-supplied fields when creating an entity.",
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "title": "Attributes",
            "type": "object"
          },
          "kind": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "visibility": {
            "default": "private",
            "enum": [
              "private",
              "public"
            ],
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "title": "EntityInput",
        "type": "object"
      },
      "GraphView": {
        "description": "Everything in the graph the caller may see.",
        "properties": {
          "entities": {
            "items": {
              "$ref": "#/components/schemas/Entity"
            },
            "title": "Entities",
            "type": "array"
          }
        },
        "required": [
          "entities"
        ],
        "title": "GraphView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Aggregate health across every downstream dependency.",
        "properties": {
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceStatus"
            },
            "title": "Services",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "services"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RegisterBeginRequest": {
        "properties": {
          "display_name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name"
        ],
        "title": "RegisterBeginRequest",
        "type": "object"
      },
      "ServiceStatus": {
        "description": "Result of probing a single downstream dependency.",
        "properties": {
          "critical": {
            "default": true,
            "title": "Critical",
            "type": "boolean"
          },
          "degraded": {
            "default": false,
            "title": "Degraded",
            "type": "boolean"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok",
          "detail",
          "latency_ms"
        ],
        "title": "ServiceStatus",
        "type": "object"
      },
      "SessionUser": {
        "description": "The authenticated user behind the current session.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "UpdateAccountRequest": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "format": "email",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "title": "UpdateAccountRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "IntelliVault",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/credentials": {
      "get": {
        "operationId": "get_credentials_auth_credentials_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CredentialSummary"
                  },
                  "title": "Response Get Credentials Auth Credentials Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Credentials",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/credentials/begin": {
      "post": {
        "operationId": "add_passkey_begin_auth_credentials_begin_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Add Passkey Begin Auth Credentials Begin Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Add Passkey Begin",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/credentials/finish": {
      "post": {
        "operationId": "add_passkey_finish_auth_credentials_finish_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPasskeyFinishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add Passkey Finish",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/credentials/{credential_id}": {
      "delete": {
        "operationId": "remove_credential_auth_credentials__credential_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "credential_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Credential Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove Credential",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login/begin": {
      "post": {
        "operationId": "login_begin_auth_login_begin_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Login Begin Auth Login Begin Post",
