    "/health": {
      "get": {
        "description": "Deep readiness \u2014 probes Postgres, Neo4j, Phoenix and Ollama concurrently.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
