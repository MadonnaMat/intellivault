  "info": {
    "title": "IntelliVault",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agent/runs": {
      "get": {
        "operationId": "list_runs_agent_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentRunSummary"
                  },
                  "title": "Response List Runs Agent Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Runs",
        "tags": [
          "agent"
        ]
      },
      "post": {
        "operationId": "create_run_agent_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRunCreate"
              }
            }
          },
          "required": true
