    "/graph": {
      "get": {
        "description": "Every entity the caller may see: their own plus all public ones.",
        "operationId": "get_graph_graph_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Graph",
        "tags": [
          "graph"
        ]
      }
    },
    "/graph/entities": {
      "post": {
        "operationId": "create_entity_graph_entities_post",
