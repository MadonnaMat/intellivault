#!/usr/bin/env bash
set -euo pipefail

# Brings the stack up (scripts/up) and asserts it actually works end to end:
#   - backend /health reports every dependency ok (not just reachable)
#   - the frontend serves its page
# Exits non-zero on the first failure.

cd "$(dirname "$0")/.."

scripts/up

BACKEND="http://localhost:${BACKEND_PORT:-8000}"
FRONTEND="http://localhost:${FRONTEND_PORT:-3000}"

echo
echo "== Checking ${BACKEND}/health =="
health="$(curl -fsS "${BACKEND}/health")"
echo "$health"

status="$(printf '%s' "$health" | python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])')"
if [ "$status" = "down" ]; then
  echo "FAIL: backend health status is 'down'" >&2
  exit 1
fi

echo
echo "== Checking ${FRONTEND} =="
# Liveness route (a plain Next handler) proves the server is up...
curl -fsS -o /dev/null "${FRONTEND}/api/healthz"
# ...and /login is server-rendered, so a 200 with real markup proves SSR works.
# (`/` 307-redirects an anonymous request, which `curl -f` would accept blindly.)
login_html="$(curl -fsS "${FRONTEND}/login")"
printf '%s' "$login_html" | grep -q 'data-testid="login-submit"' || {
  echo "FAIL: /login did not server-render the sign-in form" >&2
  exit 1
}

echo
echo "OK — health status: ${status}"
